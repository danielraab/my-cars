# Copy to .env and adjust. Every value here is a placeholder; never commit a
# real secret. These names match what docker-compose.yml sets for the app
# service, so the two stay in step.

# HTTP listener.
PORT=8080

# PostgreSQL connection string. The compose db service exposes 5432 on the
# host, so a `go run .` on the host can use this as-is.
DATABASE_URL=postgres://mycars:mycars@localhost:5432/mycars?sslmode=disable

# Outgoing mail, used by the magic-link login. The compose dev profile runs
# mailpit as a throwaway catcher on 1025, with its web UI on 8025.
SMTP_FROM=admin@example.com
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_TLS=none
# Optional SMTP authentication. Leave both empty for unauthenticated relays
# such as the local Mailpit development catcher.
SMTP_USER=
SMTP_PASSWORD=

# Public base URL the backend builds absolute links from, such as the magic
# link it mails out and the OIDC redirect URI.
AUTH_BASE_URL=http://localhost:8080

# --- Not yet implemented -----------------------------------------------------
# Generic OIDC login, added by the auth-oidc-magic-link change. The backend
# reads everything else from the issuer's discovery document, so these three
# are the whole configuration. Uncomment once that change lands.
# OIDC_ISSUER_URL=https://id.example.com
# OIDC_CLIENT_ID=my-car
# OIDC_CLIENT_SECRET=change-me
