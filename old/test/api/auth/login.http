
@host = http://localhost:3000

@userEmail = test@draab.at
@userPassword = tester
@userId = 1
@userAccessToken = 63805ef999a9a3d19603eaac



### login

POST {{host}}/api/v1/auth/login
content-type: application/json

{
    "email": "{{userEmail}}",
    "password": "{{userPassword}}"
}


### refresh token

# @prompt refreshToken refreshToken
POST {{host}}/api/v1/auth/refreshToken
content-type: application/json

{
    "userId": "{{userId}}",
    "refreshToken": "{{refreshToken}}"
}
